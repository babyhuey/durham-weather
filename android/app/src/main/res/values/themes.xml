<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DurhamWeather" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sky</item>
        <item name="android:statusBarColor">@color/sky</item>
        <item name="android:navigationBarColor">@color/sky</item>
    </style>

    <style name="WidgetDayName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/day_name</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Width caps the icon; height takes whatever the row leaves after the two text lines. -->
    <style name="WidgetDayIcon">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:maxHeight">30dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:layout_marginVertical">1dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="WidgetDayTemps">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">15dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeMaxTextSize">13sp</item>
        <item name="android:autoSizeStepGranularity">0.5sp</item>
    </style>
</resources>
